# Copy to ".env" and edit. Every value is optional; the defaults work for local development.

# --- Django ---
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=change-me          # REQUIRED when DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the REST API (the React dev server):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database: SQLite by default, MySQL 8 as in the architecture diagram ---
# DB_ENGINE=mysql
# DB_NAME=mps
# DB_USER=mps
# DB_PASSWORD=secret
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Redis: needed for live WebSocket push from the ingest process to the web process ---
# REDIS_URL=redis://127.0.0.1:6379/0

# --- MQTT broker (same variable names as the simulator and backend_reference/mqtt_ingest.py) ---
MQTT_HOST=localhost
# MQTT_PORT=1883                       # 8883 when MQTT_TLS=1
# MQTT_USER=mps_backend
# MQTT_PASS=secret
# MQTT_TLS=1
# MQTT_CA_FILE=C:\path\to\ca.crt

# --- Alert thresholds (DFD step 4) ---
MPS_TEMP_HIGH_C=60
MPS_BATTERY_LOW_V=7.0
# A satellite counts as "stale" when no telemetry arrived for this many seconds:
MPS_STALE_AFTER_S=10
